# Production environment variables (copy to .env.prod on the VPS)

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-this

# Hosts
ALLOWED_HOSTS=bhrikutimandap.com,www.bhrikutimandap.com,72.62.198.204
CSRF_TRUSTED_ORIGINS=https://bhrikutimandap.com,https://www.bhrikutimandap.com
SITE_URL=https://bhrikutimandap.com

# Database (used by Postgres container + Django)
DATABASE_NAME=bhrikuti_db
DATABASE_USER=bhrikuti_user
DATABASE_PASSWORD=change-this

# Optional gunicorn tuning
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Email (optional; keep empty if not configured yet)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@bhrikutimandap.com
