# Django Settings
DJANGO_SECRET_KEY=your-very-secret-key-change-this-in-production
DJANGO_DEBUG=False

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-vps-ip

# Database Configuration (PostgreSQL)
DATABASE_ENGINE=postgresql
DATABASE_NAME=bhrikuti_db
DATABASE_USER=bhrikuti_user
DATABASE_PASSWORD=your-strong-database-password
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Email Configuration (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Site URL (used for activation links)
SITE_URL=https://yourdomain.com
